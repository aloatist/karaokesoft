VITE_YOUTUBE_SEARCH_PROXY_URL=http://127.0.0.1:8787/api/youtube/search

# Dung cho mobile/app da build hoac deploy public. Local LAN: ws://<IP-may-laptop>:8787, production: wss://<domain>/remote-relay
VITE_REMOTE_RELAY_URL=
VITE_AUTH_API_URL=http://127.0.0.1:8788

# Chi dung cho dev noi bo. Khong dung VITE_YT_API_KEY cho ban public vi se bi dong goi vao client bundle.
VITE_YT_API_KEY=

# Dung tren server/remoteRelay.mjs de proxy YouTube Search ma khong lo key o app client.
YOUTUBE_API_KEY=
RELAY_HOST=0.0.0.0
RELAY_HEARTBEAT_INTERVAL_MS=15000

# Auth service (Phase B)
AUTH_PORT=8788
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
AUTH_COOKIE_SECURE=0
