{
  "manifest_version": 3,
  "name": "KaraokeYT Linker",
  "description": "Thêm link YouTube vào KaraokeYT bằng menu chuột phải.",
  "version": "0.1.0",
  "permissions": ["contextMenus", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "KaraokeYT",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
